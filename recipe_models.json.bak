    "steps": [
      {
        "title": "Whisk the dressing",
        "action": "Whisk the olive oil and lemon juice in the mixing bowl. Add a few grinds of black pepper.",
        "cue": "The mixture looks slightly cloudy and combined. Whisk again if it separates.",
        "care": "Wait until the salad is assembled before adding salt.",
        "image": "lemon-dressing.webp",
        "alt": "Illustration of lemon and olive oil dressing with a whisk in a ceramic bowl",
        "id": "dressing",
        "phase": "Prepare"
      },
      {
        "title": "Add the crunch",
        "action": "Drain the {{beans}} thoroughly. Add them to the dressing with cucumber, tomatoes and {{herb}}. Toss gently.",
        "cue": "The ingredients look lightly coated, without a puddle of rinse water.",
        "care": "Pat wet cucumber dry with a clean cloth before adding it.",
        "id": "combine",
        "phase": "Assemble",
        "image": "lemon-chickpea-salad-combine.webp",
        "alt": "Illustration of ingredients tossed in bowl"
      },
      {
        "title": "Finish gently",
        "action": "Fold in the feta, keeping some crumbles intact. Taste, adjust lemon and salt if needed, and divide into portions.",
        "cue": "You can still see distinct pieces of feta among the vegetables.",
        "care": "Avoid vigorous stirring, which turns the feta into a creamy coating.",
        "image": "feta-finish.webp",
        "alt": "Illustration of chickpea, cucumber and tomato salad with distinct feta crumbles",
        "id": "finish",
        "phase": "Finish"
      }
    ],
    "serve": "Serve as a light meal, or add bread or a cooked grain for a more substantial plate. These extras are not included in the ingredient amounts.",
    "variation": "For a creamier version, use the avocado option above. The illustration shows the original feta version.",
    "ahead": "For a crisper result, keep the dressing and feta separate from the prepared vegetables until serving. Refrigerate the components in covered containers.",
    "storage": "Keep at 40°F (4°C) or colder. Refrigerate within 2 hours of preparation, or within 1 hour above 90°F (32°C). Discard if left out longer. This development recipe does not yet have a tested refrigerated shelf life.",
