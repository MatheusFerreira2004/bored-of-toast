-.tip-visual-placeholder{aspect-ratio:4/3;background:rgba(18,46,75,.05);border:1px dashed rgba(64,90,66,.35);border-radius:3px;display:flex;flex-direction:column;align-items:flex-end;justify-content:flex-end;padding:20px}
+.tip-visual-placeholder{aspect-ratio:4/3;background:rgba(var(--shadow-rgb),.05);border:1px dashed rgba(64,90,66,.35);border-radius:3px;display:flex;flex-direction:column;align-items:flex-end;justify-content:flex-end;padding:20px}
 
 /* Servings control inside editorial */
 .editorial-ingredients-col .servings-control{margin-bottom:22px}
